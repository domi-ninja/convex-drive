www.drive2.humanist.design {
	redir https://drive2.humanist.design{uri} permanent
}

api.drive2.humanist.design {
	route {
		@options {
			method OPTIONS
			header Origin https://drive2.humanist.design
		}
		handle @options {
			header Access-Control-Allow-Origin https://drive2.humanist.design
			header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
			header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin, Cookie, Set-Cookie, better-auth-cookie, Convex-Client"
			header Access-Control-Allow-Credentials true
			header Access-Control-Max-Age 86400
			respond 204
		}
		@other_options method OPTIONS
		respond @other_options 403

		@websocket {
			header Connection *Upgrade*
			header Upgrade websocket
		}
		handle @websocket {
			reverse_proxy 127.0.0.1:${service.convex-backend.port.3210}
		}

		@http_actions path /api/auth/* /.well-known/* /download-zip
		handle @http_actions {
			reverse_proxy 127.0.0.1:${service.convex-backend.port.3211}
		}

		handle {
			reverse_proxy 127.0.0.1:${service.convex-backend.port.3210}
		}
	}
}

drive2.humanist.design {
	reverse_proxy 127.0.0.1:${service.web.port.80}
}
